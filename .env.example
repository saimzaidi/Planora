# GEMINI_API_KEY: Required for Gemini AI API recommendations & outing plan generation.
# In Vercel, add this to Project Settings -> Environment Variables.
# In AI Studio, this is automatically configured from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GOOGLE_MAPS_API_KEY: Required for Google Maps Places API & Geocoding.
# In Vercel, add this to Project Settings -> Environment Variables.
GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# VITE_GOOGLE_MAPS_API_KEY: Optional backward-compatible fallback for Google Maps.
# VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
